    {
      "type": "stat",
      "title": "Mean attempts / campaign",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 4,
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 2 }, "overrides": [] },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(phishcraft_experiment_attempts_total{experiment=~\"$experiment\"}) / clamp_min(sum(phishcraft_experiment_runs_total{experiment=~\"$experiment\", status=\"ok\"}), 1)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Campaign duration (mean, per model)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "phishcraft_experiment_duration_seconds{experiment=~\"$experiment\", quantile=\"mean\"}",
          "legendFormat": "{{model}}",
          "range": true
        }
      ]
    },
