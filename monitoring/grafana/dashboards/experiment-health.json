  "panels": [
    {
      "type": "stat",
      "title": "Campaigns ok",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 1,
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "sum(phishcraft_experiment_runs_total{experiment=~\"$experiment\", status=\"ok\"})" }
      ]
    },
    {
      "type": "stat",
      "title": "Generation errors",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 2,
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "sum(phishcraft_experiment_runs_total{experiment=~\"$experiment\", status=\"generation_error\"})" }
      ]
    },
    {
      "type": "stat",
      "title": "Timeouts",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
