{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "gauge",
      "title": "VRAM used",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 1,
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(phishcraft_gpu_memory_used_bytes) / clamp_min(sum(phishcraft_gpu_memory_total_bytes), 1)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "VRAM in use",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 2,
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "sum(phishcraft_gpu_memory_used_bytes)" }
      ]
    },
    {
      "type": "stat",
      "title": "GPU temperature",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 3,
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "celsius" }, "overrides": [] },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "avg(phishcraft_gpu_temperature_celsius)" }
      ]
    },
    {
      "type": "stat",
      "title": "Host load (1m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 4,
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 2 }, "overrides": [] },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "node_load1" }
      ]
    },
    {
      "type": "timeseries",
      "title": "GPU utilization",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 5,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "phishcraft_gpu_utilization_ratio * 100",
          "legendFormat": "{{name}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GPU power draw",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 6,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "phishcraft_gpu_power_watts",
          "legendFormat": "{{name}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Host CPU usage",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 7,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Host memory used",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GPU temperature",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 9,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "phishcraft_gpu_temperature_celsius",
          "legendFormat": "{{name}}",
          "range": true
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["phishcraft", "gpu", "host"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "GPU & Host",
  "uid": "phishcraft-gpu-host",
  "version": 1
}
